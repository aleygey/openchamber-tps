{
  "name": "openchamber-tps",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "TPS meter with UI-password authentication, persistent per-session active average/peak and activity charts.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.1.1"
    },
    "contributes": {
      "panel": {
        "id": "tps-meter",
        "name": "TPS Meter",
        "icon": "speed-up-line",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "TPS",
        "height": 240
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleygey/openchamber-tps.git"
  }
}
